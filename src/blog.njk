---
layout: base.njk
title: Blog
description: Notes on web development, the TALL stack, and the road from Umschulung to software developer.
---
{% import "partials/i18n.njk" as i18n %}

{#
  Posts are grouped by the language they are written in (`docLang` in the
  front matter). Both groups are rendered; `html[data-lang]` reveals the one
  matching the reader's choice, so switching EN/DE needs no round trip.

  Note: no server-side pagination — the archive is small enough to ship whole,
  and paginating a mixed-language collection would leave lopsided pages.
#}
<section class="section-alt border-t-0">
  <div class="shell pt-14 pb-10 sm:pt-20 sm:pb-12">
    <h1 class="display text-[clamp(2rem,4.4vw,3rem)] tracking-[-0.025em]">Blog</h1>
    <p class="lede mt-4 text-[17px]">
      {{ i18n.t(
        "Notes on web development, the TALL stack, and the road from Umschulung to software developer.",
        "Notizen zu Webentwicklung, dem TALL-Stack und dem Weg von der Umschulung zum Softwareentwickler."
      ) }}
    </p>
  </div>
</section>

<section class="section">
  <div class="section-body">
    {% for locale in ["en", "de"] %}
      {% set localePosts = collections.post | byLang(locale) | reverse %}
      {% set dateLocale = "en-GB" if locale == "en" else "de-DE" %}

      <div {% if locale == "en" %}data-lang-en{% else %}data-lang-de{% endif %}>
        {% if localePosts.length %}

          {# --- Newest post, given the room it deserves --- #}
          {% set lead = localePosts[0] %}
          <article class="card group mb-8 overflow-hidden">
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,340px),1fr))] items-stretch">
              <div class="order-last flex flex-col justify-center gap-4 p-[clamp(1.75rem,3vw,2.75rem)]">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <span class="badge border-accent-line bg-accent-bg text-accent-soft">
                    {{ i18n.t("LATEST", "NEUESTE") }}
                  </span>
                  <time datetime="{{ lead.date | isoDate }}" class="font-mono text-xs text-fg-faint">
                    {{ lead.date | postDate(dateLocale) }}
                  </time>
                  <span class="font-mono text-xs text-fg-faint">
                    {{ lead.templateContent | readingTime }} min
                  </span>
                </div>

                <h2 class="display text-[clamp(1.5rem,3vw,2rem)] leading-[1.15]">
                  <a href="{{ lead.url }}" class="text-fg transition-colors hover:text-accent">{{ lead.data.title }}</a>
                </h2>

                <p class="m-0 text-fg-muted text-pretty">
                  {{ lead.data.description or (lead.templateContent | striptags | truncate(200)) }}
                </p>

                <div class="flex flex-wrap gap-2">
                  {% for tag in lead.data.tags | visibleTags %}
                    <a href="/tags/{{ tag | slugify }}/" class="tag-pill">#{{ tag }}</a>
                  {% endfor %}
                </div>
              </div>

              <div class="bg-well">
                {% image "src" + (lead.data.image | default('/assets/images/hero-2.jpg')), lead.data.imageAlt | default(lead.data.title), "h-full w-full object-cover", "(max-width: 768px) 100vw, 560px" %}
              </div>
            </div>
          </article>

          {# --- Everything else --- #}
          {% if localePosts.length > 1 %}
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-5">
              {% for post in localePosts %}
                {% if not loop.first %}
                  <article class="card flex flex-col overflow-hidden transition-colors hover:border-line-4">
                    <div class="aspect-16/9 overflow-hidden bg-well">
                      {% image "src" + (post.data.image | default('/assets/images/hero-2.jpg')), post.data.imageAlt | default(post.data.title), "h-full w-full object-cover", "(max-width: 768px) 100vw, 360px" %}
                    </div>
                    <div class="flex flex-1 flex-col gap-2.5 p-6">
                      <div class="flex flex-wrap items-center gap-x-3 font-mono text-xs text-fg-faint">
                        <time datetime="{{ post.date | isoDate }}">{{ post.date | postDate(dateLocale) }}</time>
                        <span>{{ post.templateContent | readingTime }} min</span>
                      </div>
                      <h2 class="font-display text-[19px] leading-[1.3] font-semibold">
                        <a href="{{ post.url }}" class="text-fg transition-colors hover:text-accent">{{ post.data.title }}</a>
                      </h2>
                      <div class="mt-auto flex flex-wrap gap-2 pt-2">
                        {% for tag in post.data.tags | visibleTags %}
                        <a href="/tags/{{ tag | slugify }}/" class="tag-pill">#{{ tag }}</a>
                      {% endfor %}
                      </div>
                    </div>
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}

        {% else %}
          <div class="card px-6 py-16 text-center">
            <p class="m-0 text-fg-dim">
              {{ i18n.t(
                "No English articles published yet. Check back soon.",
                "Noch keine deutschsprachigen Beiträge veröffentlicht. Schau bald wieder vorbei."
              ) }}
            </p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
