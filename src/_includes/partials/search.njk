{% import "partials/i18n.njk" as i18n %}

<div x-data="searchComponent()"
     @open-search.window="openModal()"
     @keydown.window.escape="closeModal()"
     @keydown.window.ctrl.k.prevent="openModal()"
     @keydown.window.meta.k.prevent="openModal()"
     x-effect="document.body.classList.toggle('overflow-hidden', isOpen)"
     class="relative z-100"
     x-cloak>

    <!-- Modal Backdrop -->
    <div x-show="isOpen"
         x-transition:enter="ease-out duration-300"
         x-transition:enter-start="opacity-0"
         x-transition:enter-end="opacity-100"
         x-transition:leave="ease-in duration-200"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 bg-black/70 backdrop-blur-sm transition-opacity"></div>

    <!-- Modal Content -->
    <div x-show="isOpen" class="fixed inset-0 z-101 w-screen p-4 sm:p-6 md:p-20">
        <div class="flex min-h-full items-start justify-center">
            <div x-show="isOpen"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 @click.away="closeModal()"
                 class="mx-auto mt-4 w-full max-w-2xl transform overflow-hidden rounded-2xl border border-line-2 bg-surface text-left shadow-[0_32px_80px_rgba(0,0,0,0.6)] transition-all sm:mt-16">

                <!-- Search Input Header -->
                <div class="relative border-b border-line">
                    <svg class="pointer-events-none absolute top-4.5 left-4 size-5 text-fg-faint" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
                    </svg>
                    <input type="text"
                           x-ref="searchInput"
                           class="h-14 w-full border-0 bg-transparent pr-4 pl-11 text-fg outline-none placeholder:text-fg-faint"
                           placeholder="Search posts, projects, certificates…"
                           data-ph-en="Search posts, projects, certificates…"
                           data-ph-de="Beiträge, Projekte, Zertifikate suchen…"
                           x-model="query"
                           @input.debounce.300ms="performSearch()">
                </div>

                <!-- Results -->
                <div x-show="results.length > 0" class="custom-scrollbar max-h-[60vh] overflow-y-auto">
                    <div class="label bg-ink-2 px-4 py-3">
                        {{ i18n.t("Results", "Treffer") }} (<span x-text="results.length"></span>)
                    </div>
                    <ul class="divide-y divide-line" id="options" role="listbox">
                        <template x-for="result in results" :key="result.url">
                            <li class="relative">
                                <a :href="result.url" class="group flex flex-col gap-1.5 px-4 py-4 transition-colors hover:bg-ink-2">
                                    <span class="font-display text-[15px] font-semibold text-fg transition-colors group-hover:text-accent" x-text="result.meta.title"></span>
                                    <span class="search-excerpt line-clamp-2 text-sm leading-relaxed text-fg-muted" x-html="result.excerpt"></span>
                                    <span class="font-mono text-[11px] text-fg-faint" x-text="result.url"></span>
                                </a>
                            </li>
                        </template>
                    </ul>
                </div>

                <!-- Empty state -->
                <div x-show="query.length >= 2 && results.length === 0 && !loading" class="px-6 py-14 text-center">
                    <p class="font-display text-base font-semibold text-fg">{{ i18n.t("No results found", "Keine Treffer") }}</p>
                    <p class="mt-1.5 text-sm text-fg-dim">
                        {{ i18n.t("Nothing matched", "Nichts gefunden für") }}
                        “<span class="text-fg" x-text="query"></span>”.
                    </p>
                </div>

                <!-- Idle state -->
                <div x-show="query.length < 2 && !loading" class="px-6 py-10 text-center">
                    <p class="text-sm text-fg-dim">
                        {{ i18n.t("Type at least 2 characters to start searching.", "Mindestens 2 Zeichen eingeben, um zu suchen.") }}
                    </p>
                    <div class="mt-4 flex flex-wrap justify-center gap-4 font-mono text-[11px] tracking-widest text-fg-faint uppercase">
                        <span class="flex items-center gap-1.5">
                            <kbd class="rounded border border-line-3 bg-ink-2 px-1.5 py-0.5 font-mono">ESC</kbd>
                            {{ i18n.t("to close", "schließen") }}
                        </span>
                        <span class="flex items-center gap-1.5">
                            <kbd class="rounded border border-line-3 bg-ink-2 px-1.5 py-0.5 font-mono">ENTER</kbd>
                            {{ i18n.t("to select", "auswählen") }}
                        </span>
                    </div>
                </div>

                <!-- Loading state -->
                <div x-show="loading" class="px-6 py-14 text-center">
                    <div class="mb-4 inline-block size-8 animate-spin rounded-full border-4 border-accent border-t-transparent"></div>
                    <p class="text-sm text-fg-dim">{{ i18n.t("Searching…", "Suche läuft…") }}</p>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-between border-t border-line bg-ink-2 px-4 py-3 font-mono text-[11px] text-fg-faint">
                    <span>{{ i18n.t("Powered by", "Angetrieben von") }} <span class="text-fg-dim">Pagefind</span></span>
                    <span class="hidden sm:block">
                        <kbd class="rounded border border-line-3 px-1.5 py-0.5">↑↓</kbd> {{ i18n.t("to navigate", "navigieren") }}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function searchComponent() {
        return {
            isOpen: false,
            query: '',
            results: [],
            pagefind: null,
            loading: false,

            async initPagefind() {
                if (this.pagefind) return;
                try {
                    this.pagefind = await import("/pagefind/pagefind.js");
                    await this.pagefind.options({
                        "excerptLength": 20
                    });
                    await this.pagefind.init();
                    // Pagefind builds one index per page language. Merge the
                    // other one so a single search covers the whole site.
                    const other = document.documentElement.lang === "de" ? "en" : "de";
                    try {
                        await this.pagefind.mergeIndex("/pagefind", { language: other });
                    } catch (e) {
                        // No index for that language yet — search the current one.
                    }
                } catch (e) {
                    console.error("Pagefind failed to load", e);
                }
            },

            async openModal() {
                this.isOpen = true;
                this.query = '';
                this.results = [];
                this.$nextTick(() => {
                    this.$refs.searchInput.focus();
                });
                await this.initPagefind();
            },

            closeModal() {
                this.isOpen = false;
            },

            async performSearch() {
                if (this.query.length < 2) {
                    this.results = [];
                    return;
                }

                this.loading = true;
                await this.initPagefind();

                if (!this.pagefind) {
                    this.loading = false;
                    return;
                }

                const search = await this.pagefind.search(this.query);
                const resultsData = await Promise.all(
                    search.results.slice(0, 20).map(r => r.data())
                );

                this.results = resultsData;
                this.loading = false;
            }
        }
    }
</script>
