{% import "partials/i18n.njk" as i18n %}

<section id="stack" class="section-alt scroll-mt-20">
  <div class="section-body">

    <div class="section-head mb-9">
      <span class="eyebrow">04</span>
      <h2>{{ i18n.t("Stack & credentials", "Stack & Nachweise") }}</h2>
    </div>

    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-[clamp(2rem,4vw,3rem)]">

      <div>
        {% for group in skills.groups %}
          <h3 class="label m-0 mb-5 {{ 'mt-8' if not loop.first }}">{{ i18n.t(group.title, group.titleDe) }}</h3>
          <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
            {% for item in group.items %}
              <li class="{{ 'pill-accent' if group.accent else 'pill' }}">{{ item }}</li>
            {% endfor %}
          </ul>
        {% endfor %}
      </div>

      <div>
        <h3 class="label m-0 mb-5">{{ i18n.t("Selected certificates", "Ausgewählte Zertifikate") }}</h3>

        {% set featured = certificates.items | where("featured", true) %}
        <ul class="rail m-0 mb-5 list-none p-0">
          {% for cert in featured %}
            {% if loop.index <= 4 %}
              <li class="px-5 py-[18px]">
                <div class="mb-1 font-display text-base font-semibold">{{ cert.name }}</div>
                <div class="text-[13.5px] text-fg-dim">
                  {{ cert.issuer }} ·
                  <span data-lang-en>{{ cert.date | monthYear("en-GB") }}</span
                  ><span data-lang-de>{{ cert.date | monthYear("de-DE") }}</span>
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <a href="/certificates/" class="link-arrow">
          {{ i18n.t(
            "All " + (certificates.items | length) + " certificates",
            "Alle " + (certificates.items | length) + " Zertifikate"
          ) }} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>
  </div>
</section>
