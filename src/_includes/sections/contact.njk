{% import "partials/i18n.njk" as i18n %}

<section id="contact" class="section scroll-mt-20">
  <div class="shell py-[clamp(3.75rem,8vw,6rem)]">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-center gap-[clamp(2rem,5vw,3.5rem)]">

      <div>
        <h2 class="display mb-4 text-[clamp(1.875rem,4vw,2.75rem)] tracking-[-0.025em] text-pretty">
          {{ i18n.t("Let’s talk.", "Sprechen wir.") }}
        </h2>
        <p class="m-0 max-w-[48ch] text-fg-muted text-pretty">
          {{ i18n.t(
            "A question or a project idea is always welcome.",
            "Fragen und Projektideen sind jederzeit willkommen."
          ) }}
        </p>
      </div>

      <div class="flex flex-wrap items-start gap-3">
        <a href="mailto:{{ site.email }}"
           class="btn-primary max-w-full px-[22px] py-[15px] text-[clamp(0.875rem,3.6vw,1rem)] [overflow-wrap:anywhere]">
          {{ site.email }}
        </a>
        <a href="{{ site.github }}" rel="noopener"
           class="btn-ghost max-w-full px-[22px] py-[15px] text-[clamp(0.875rem,3.6vw,1rem)] [overflow-wrap:anywhere]">
          {{ site.github | replace("https://", "") }}
        </a>
      </div>

    </div>
  </div>
</section>
