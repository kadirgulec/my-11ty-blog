{% import "partials/i18n.njk" as i18n %}

<section id="top" class="relative overflow-hidden bg-ink">
  {#
    The dot grid paints its own #101418 ground and a bottom fade.
    data-align-to centres the initials on the stat card below them;
    below data-text-min-width only the ambient dots remain (see dotted-grid.js).
  #}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <canvas data-dotted-grid
            data-text="kg"
            data-align-to="#hero-stats"
            data-text-min-width="860"
            class="block size-full"></canvas>
    <div class="absolute inset-0 bg-gradient-to-b from-ink/55 via-ink/20 to-ink"></div>
  </div>

  <div class="shell relative z-10 pt-[clamp(4rem,9vw,7rem)] pb-[clamp(3.5rem,7vw,5.5rem)]">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-end gap-[clamp(2.25rem,5vw,3.5rem)]">

      <div>
        <div class="mb-5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5 font-mono text-[13px] tracking-[0.08em] text-accent uppercase">
          <span class="whitespace-nowrap">Software Developer</span>
          <span class="text-accent-dim">·</span>
          <span class="whitespace-nowrap">Laravel &amp; PHP</span>
          <span class="text-accent-dim">·</span>
          <span class="whitespace-nowrap">Düren</span>
        </div>

        <h1 class="display mb-6 text-[clamp(2.375rem,5.2vw,3.875rem)] leading-[1.05] tracking-[-0.03em] text-pretty">
          {{ i18n.t(
            "I build web apps that keep the boring stuff under control.",
            "Ich baue Web-Apps, die den lästigen Kram im Griff behalten."
          ) }}
        </h1>

        <p class="mb-8 max-w-[56ch] text-[18.5px] text-fg-muted text-pretty">
          {{ i18n.t(
            "Full-stack developer at aks-Service GmbH, working daily in PHP, Laravel, Livewire and Alpine.js. Career changer: eleven years in public administration, then retraining and the IHK exam.",
            "Full-Stack-Entwickler bei der aks-Service GmbH, täglich in PHP, Laravel, Livewire und Alpine.js. Quereinsteiger: elf Jahre öffentlicher Dienst, dann Umschulung und IHK-Prüfung."
          ) }}
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="#work" class="btn-primary">
            {{ i18n.t("See what I've built", "Meine Projekte ansehen") }}
          </a>
          <a href="{{ site.github }}" rel="noopener" class="btn-ghost">GitHub</a>
        </div>
      </div>

      <dl id="hero-stats" class="rail m-0 backdrop-blur-[6px]">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1.5 px-[18px] py-4">
          <dt class="text-[13.5px] text-fg-dim">{{ i18n.t("Current role", "Aktuell") }}</dt>
          <dd class="m-0 text-right font-display text-[15px] font-medium">Software Developer, aks-Service</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1.5 px-[18px] py-4">
          <dt class="text-[13.5px] text-fg-dim">{{ i18n.t("In software since", "In der IT seit") }}</dt>
          <dd class="m-0 font-display text-[15px] font-medium">2022</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1.5 px-[18px] py-4">
          <dt class="text-[13.5px] text-fg-dim">{{ i18n.t("Qualification", "Abschluss") }}</dt>
          <dd class="m-0 text-right font-display text-[15px] font-medium">Fachinformatiker AE, IHK Bonn 2025</dd>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1.5 px-[18px] py-4">
          <dt class="text-[13.5px] text-fg-dim">{{ i18n.t("Languages", "Sprachen") }}</dt>
          <dd class="m-0 font-display text-[15px] font-medium">Deutsch · Türkçe · English</dd>
        </div>
      </dl>

    </div>
  </div>
</section>
