{% import "partials/i18n.njk" as i18n %}

<section id="about" class="section-alt scroll-mt-20">
  <div class="section-body">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-[clamp(2.25rem,5vw,3.5rem)]">

      <div>
        <div class="section-head mb-6">
          <span class="eyebrow">02</span>
          <h2>{{ i18n.t("About me", "Über mich") }}</h2>
        </div>

        <p class="mb-[18px] max-w-[60ch] text-[17px] text-fg-muted text-pretty">
          {{ i18n.t(
            "My way into IT came from a plain question: how does this actually work? Answering it turned into desktop simulations, then dynamic websites, then the apps above.",
            "Mein Weg in die IT begann mit einer einfachen Frage: Wie funktioniert das eigentlich? Aus dem Beantworten wurden Desktop-Simulationen, dann dynamische Websites und schließlich die Anwendungen oben."
          ) }}
        </p>
        <p class="max-w-[60ch] text-[17px] text-fg-muted text-pretty">
          {{ i18n.t(
            "Before that I spent seven years as a specialist at the Turkish Ministry of Interior. That background shows up in how I work: documented, reliable, calm about deadlines — and used to learning a new system quickly because the job required it.",
            "Davor war ich sieben Jahre Sachbearbeiter im türkischen Innenministerium. Das prägt meine Arbeitsweise: dokumentiert, verlässlich, ruhig bei Fristen — und gewohnt, neue Systeme schnell zu lernen, weil der Job es verlangt hat."
          ) }}
        </p>
      </div>

      {# Counts are derived from the CMS-managed data files so they cannot drift. #}
      {% set stats = [
        { value: year - 2022, en: "years in software",        de: "Jahre in der Softwareentwicklung" },
        { value: projects.items | published | length,     en: "apps running in production", de: "Anwendungen im Live-Betrieb" },
        { value: certificates.items | length, en: "certificates and degrees",   de: "Zertifikate und Abschlüsse" },
        { value: 3, en: "languages spoken", de: "gesprochene Sprachen" }
      ] %}

      {# self-start: without it the rail stretches and its hairline colour shows as dead space. #}
      <dl class="rail m-0 grid-cols-2 self-start">
        {% for stat in stats %}
          <div class="px-[22px] py-[26px]">
            <dt class="sr-only">{{ stat.en }}</dt>
            <dd class="m-0">
              <span class="block font-display text-[34px] leading-none font-semibold tracking-[-0.02em] text-accent">{{ stat.value }}</span>
              <span class="mt-1.5 block text-[13.5px] text-fg-dim">{{ i18n.t(stat.en, stat.de) }}</span>
            </dd>
          </div>
        {% endfor %}
      </dl>

    </div>
  </div>
</section>
