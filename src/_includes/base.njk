<!DOCTYPE html>
<html lang="{{ docLang or lang or 'en' }}" data-lang="{{ docLang or 'en' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% set pageUrl = site.url + page.url %}
    {% set pageDescription = (description or 'Kadir Gülec - Software Developer Portfolio') | oneLine %}
    {#
      `generatedCard` tracks whether the share image is one of the build-time
      1200x630 cards. A front-matter `image` is any shape, so its dimensions
      must not be declared below.
    #}
    {# Facebook, LinkedIn and X do not render SVG share images; those posts get the generated card. #}
    {% if image and not (image | lower).endsWith('.svg') %}
        {% set pageImage = site.url + image %}
        {% set generatedCard = false %}
    {% elif layout == 'post.njk' %}
        {% set pageImage = site.url + '/assets/og/' + (page.url | ogSlug) + '.png' %}
        {% set generatedCard = true %}
    {% else %}
        {% set pageImage = site.url + '/assets/og/home.png' %}
        {% set generatedCard = true %}
    {% endif %}

    {# The homepage titles already lead with the name. #}
    <title>{{ title }}{% if page.url not in ['/', '/de/'] %} | {{ site.author }}{% endif %}</title>
    <meta name="description" content="{{ pageDescription }}">
    <meta name="author" content="{{ site.author }}">
    <link rel="canonical" href="{{ pageUrl }}">
    {#
      Posts, project pages, the homepage, the blog and the certificates exist in
      English and German. hreflang tells Google they are translations of each
      other, not duplicates, and which one to show a reader. Every version lists
      all of them, itself included; English is the fallback for any other
      language. The header's language switch links to the same `versions`.
    #}
    {% set pageLang = docLang or lang or 'en' %}
    {% if layout == 'post.njk' %}
        {% set versions = collections.post | translations(page.inputPath) %}
    {% elif layout == 'project.njk' %}
        {% set versions = collections.projectPage | translations(page.inputPath) %}
    {% elif locales %}
        {# Built once per language from one template (see index.njk). #}
        {% set versions = collections.all | where("inputPath", page.inputPath) %}
    {% else %}
        {% set versions = [] %}
    {% endif %}
    {% for version in versions %}
    <link rel="alternate" hreflang="{{ version.data.docLang or 'en' }}" href="{{ site.url }}{{ version.url }}">
    {% if (version.data.docLang or 'en') == 'en' %}
    <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ version.url }}">
    {% endif %}
    {% endfor %}

    <meta property="og:title" content="{{ title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:type" content="{{ 'article' if layout in ['post.njk', 'project.njk'] else 'website' }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="{{ pageImage }}">
    {% if generatedCard %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {% endif %}
    {% if imageAlt %}<meta property="og:image:alt" content="{{ imageAlt }}">{% endif %}
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ 'de_DE' if pageLang == 'de' else 'en_US' }}">
    {% for version in versions %}{% if (version.data.docLang or 'en') != pageLang %}
    <meta property="og:locale:alternate" content="{{ 'de_DE' if version.data.docLang == 'de' else 'en_US' }}">
    {% endif %}{% endfor %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ pageImage }}">

    {% if robots %}
    <meta name="robots" content="{{ robots }}">
    {% endif %}

    {% if page.url == '/' or page.url == '/de/' %}
    {% if page.url == '/' %}
    {# Google reads the site name shown above results from WebSite data on the homepage. #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "{{ site.author }}",
      "alternateName": ["{{ site.name }}", "{{ site.url | replace('https://', '') }}"],
      "url": "{{ site.url }}/"
    }
    </script>
    {% endif %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "{{ site.url }}/#person",
      "name": "{{ site.author }}",
      "url": "{{ site.url }}",
      "email": "mailto:{{ site.email }}",
      "image": {
        "@type": "ImageObject",
        "url": "{{ site.url }}/assets/og/logo.png",
        "width": 1024,
        "height": 1024,
        "caption": "{{ site.author }} — Logo"
      },
      "jobTitle": ["Webentwickler", "Software Developer"],
      "description": {{ pageDescription | dump | safe }},
      "address": {
        "@type": "PostalAddress",
        "postalCode": "{{ site.address.postalCode }}",
        "addressLocality": "{{ site.address.locality }}",
        "addressRegion": "{{ site.address.region }}",
        "addressCountry": "{{ site.address.country }}"
      },
      "areaServed": {{ site.areaServed | dump | safe }},
      "knowsAbout": {{ site.knowsAbout | dump | safe }},
      "knowsLanguage": ["de", "tr", "en"],
      "worksFor": {
        "@type": "Organization",
        "name": "aks-Service GmbH"
      },
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "name": "Fachinformatiker für Anwendungsentwicklung",
        "credentialCategory": "IHK-Abschluss",
        "recognizedBy": {
          "@type": "Organization",
          "name": "IHK Bonn/Rhein-Sieg"
        }
      },
      "sameAs": ["{{ site.github }}"]
    }
    </script>
    {% elif layout == 'post.njk' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "description": {{ pageDescription | dump | safe }},
      "url": "{{ pageUrl }}",
      "image": "{{ pageImage }}",
      "datePublished": "{{ page.date | isoDate }}",
      "inLanguage": "{{ docLang or 'en' }}",
      "author": {
        "@type": "Person",
        "name": "{{ site.author }}",
        "url": "{{ site.url }}"
      },
      "mainEntityOfPage": "{{ pageUrl }}"
    }
    </script>
    {% elif layout == 'project.njk' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": {{ title | dump | safe }},
      "description": {{ pageDescription | dump | safe }},
      "url": "{{ pageUrl }}",
      "image": "{{ pageImage }}",
      "datePublished": "{{ page.date | isoDate }}",
      "inLanguage": "{{ docLang or 'en' }}",
      "author": {
        "@type": "Person",
        "name": "{{ site.author }}",
        "url": "{{ site.url }}"
      }
    }
    </script>
    {% endif %}

    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png">
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <link rel="manifest" href="/assets/site.webmanifest">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#101418">
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Blog" href="{{ site.url }}/feed.xml">

    {% if not docLang %}
    <script>
        // Only pages without a fixed language (tag pages, 404) ship both
        // variants of their strings. Stamp the reader's stored choice before
        // first paint so the inactive variant is hidden without a flash.
        // Only data-lang changes: `lang` stays the document's own language,
        // which is what Pagefind keys its search index on. Individual
        // bilingual fragments carry their own `lang` (see partials/i18n.njk).
        // Every other page's language comes from its URL and is never
        // overridden here.
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('site-lang'); } catch (e) {}
            if (stored === 'de' || stored === 'en') {
                document.documentElement.setAttribute('data-lang', stored);
            }
        })();
    </script>
    {% endif %}

    {#
      Start the above-the-fold faces downloading with the CSS rather than after
      it. Without this the headline first paints in the fallback, then reflows
      when Space Grotesk arrives — a visible jump on every uncached load.
    #}
    <link rel="preload" href="/assets/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Link to the Splide CSS file (before style.css so site overrides win) -->
    <link rel="stylesheet" href="/assets/vendor/splide.min.css">
    <!-- Tailwind CSS Output -->
    <link rel="stylesheet" href="/style.css">
    <!-- Prism theme for build-time syntax highlighting -->
    <link rel="stylesheet" href="/assets/vendor/prism-tomorrow.min.css">
    <!-- Alpine.js -->
    <script defer src="/assets/vendor/alpine.min.js"></script>
</head>
<body class="custom-scrollbar min-h-screen bg-ink font-sans text-fg">
  <a href="#main" class="btn-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100">Skip to content</a>

  {% include "header.njk" %}

  <main id="main"{% if not excludeFromSearch %} data-pagefind-body{% endif %}>
    {{ content | safe }}
  </main>

  {% include "footer.njk" %}

  {% include "partials/search.njk" %}

<!-- Splide JS (Local) -->
<script src="/assets/vendor/splide.min.js"></script>

{% if site.goatcounter %}
<!-- GoatCounter: privacy-friendly analytics, no cookies -->
<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
