{% import "partials/i18n.njk" as i18n %}

{% set navigation = [
  { en: 'Work',         de: 'Projekte',    url: '/#work' },
  { en: 'Path',         de: 'Weg',         url: '/#path' },
  { en: 'Certificates', de: 'Zertifikate', url: '/certificates/' },
  { en: 'Blog',         de: 'Blog',        url: '/blog/' }
] %}

<header class="sticky top-0 z-50 border-b border-line bg-ink/[0.88] backdrop-blur-md">
  <div class="shell flex flex-wrap items-center gap-x-6 gap-y-4 py-3">

    <a href="/" class="font-display text-[17px] font-semibold tracking-[-0.01em] whitespace-nowrap text-fg hover:text-white">
      Kadir Gülec
    </a>

    <nav aria-label="Global"
         class="-mx-1 mr-auto flex min-w-0 flex-nowrap items-center gap-x-[22px] gap-y-3.5 overflow-x-auto px-1 [scrollbar-width:none] max-md:[&::-webkit-scrollbar]:hidden md:flex-wrap">
      {% for item in navigation %}
        <a href="{{ item.url }}"
           {% if item.url == page.url %}aria-current="page"{% endif %}
           class="text-[14.5px] whitespace-nowrap transition-colors hover:text-fg {{ 'text-fg' if item.url == page.url else 'text-fg-dim' }}">
          {{ i18n.t(item.en, item.de) }}
        </a>
      {% endfor %}
    </nav>

    <button type="button"
            @click="$dispatch('open-search')"
            class="-m-2 shrink-0 p-2 text-fg-dim transition-colors hover:text-fg"
            title="Search (Ctrl+K)"
            data-title-en="Search (Ctrl+K)"
            data-title-de="Suche (Strg+K)">
      <span class="sr-only">{{ i18n.t("Search", "Suche") }}</span>
      <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
    </button>

    <div class="lang-switch shrink-0" role="group" aria-label="Language">
      <button type="button" data-set-lang="en" lang="en">EN</button>
      <button type="button" data-set-lang="de" lang="de">DE</button>
    </div>

    <a href="mailto:{{ site.email }}"
       class="hidden shrink-0 rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover md:inline-block">
      {{ i18n.t("Get in touch", "Kontakt") }}
    </a>
  </div>
</header>

<script>
  // Language switch. Kept inline and dependency-free so it responds before
  // Alpine has loaded; base.njk applies the stored value on first paint.
  (function () {
    // Text nodes are swapped by CSS, but attributes need JS. Elements opt in
    // with data-ph-en/data-ph-de (placeholder) or data-title-en/data-title-de.
    function applyAttributes(lang) {
      var suffix = lang === 'de' ? 'De' : 'En';
      document.querySelectorAll('[data-ph-en]').forEach(function (el) {
        el.setAttribute('placeholder', el.dataset['ph' + suffix]);
      });
      document.querySelectorAll('[data-title-en]').forEach(function (el) {
        el.setAttribute('title', el.dataset['title' + suffix]);
      });
    }

    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-set-lang]');
      if (!button) return;
      var lang = button.dataset.setLang;
      document.documentElement.setAttribute('data-lang', lang);
      try { localStorage.setItem('site-lang', lang); } catch (e) {}
      applyAttributes(lang);
    });

    document.addEventListener('DOMContentLoaded', function () {
      applyAttributes(document.documentElement.getAttribute('data-lang'));
    });
  })();
</script>
