{% import "partials/i18n.njk" as i18n %}

{#
  `compact` marks the items that survive in the narrow header. Work and Path are
  only anchors into the homepage, so dropping them below md leaves room for the
  whole bar on one row; the two real destinations stay.
#}
{% set navigation = [
  { en: 'Work',         de: 'Projekte',    url: '/#work',         compact: false },
  { en: 'Path',         de: 'Weg',         url: '/#path',         compact: false },
  { en: 'Certificates', de: 'Zertifikate', url: '/certificates/', compact: true },
  { en: 'Blog',         de: 'Blog',        url: '/blog/',         compact: true }
] %}

<header class="sticky top-0 z-50 border-b border-line bg-ink/[0.88] backdrop-blur-md">
  <div class="shell flex flex-nowrap items-center gap-x-3 py-3 sm:gap-x-4 md:gap-x-6">

    <a href="/" class="-m-1.5 shrink-0 p-1.5 text-fg transition-colors hover:text-white">
      <span class="sr-only">Kadir Gülec — {{ i18n.t("Home", "Startseite") }}</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"
           preserveAspectRatio="xMidYMid meet" class="size-9" aria-hidden="true">
        <g transform="translate(0.000000,1024.000000) scale(0.100000,-0.100000)" fill="currentColor" stroke="none"> 
          <path d="M4850 10233 c-431 -31 -681 -70 -1047 -163 -671 -173 -1351 -517 -1893 -959 -494 -403 -879 -845 -1205 -1386 -63 -104 -228 -429 -289 -570 -206 -472 -345 -1025 -397 -1580 -19 -196 -16 -724 4 -925 121 -1166 539 -2118 1309 -2977 401 -447 910 -834 1473 -1118 599 -303 1179 -470 1860 -537 196 -19 719 -16 940 6 784 76 1492 309 2162 712 743 446 1385 1105 1816 1864 197 348 388 821 486 1202 101 391 171 938 171 1330 0 976 -294 1965 -826 2780 -490 750 -1142 1341 -1944 1761 -607 318 -1309 512 -2010 557 -150 9 -499 11 -610 3z m800 -892 c366 -50 672 -126 975 -241 1168 -446 2083 -1381 2505 -2560 108 -302 191 -681 231 -1060 16 -158 14 -578 -5 -755 -49 -454 -128 -776 -297 -1215 -49 -127 -217 -458 -305 -600 -83 -134 -221 -333 -288 -415 -383 -473 -797 -822 -1308 -1106 -149 -83 -390 -192 -568 -257 -654 -239 -1314 -313 -2015 -226 -356 43 -711 138 -1096 292 -82 33 -383 180 -464 227 -483 280 -913 653 -1246 1080 -461 592 -755 1285 -858 2025 -74 529 -60 921 49 1463 73 359 175 654 348 1007 207 421 474 794 801 1120 354 353 729 619 1176 836 434 210 852 330 1355 388 206 24 204 24 540 21 253 -3 346 -7 470 -24z"/> 
          <path d="M3886 7363 c-67 -17 -138 -98 -177 -202 -54 -144 -220 -805 -400 -1591 -38 -168 -81 -352 -94 -410 -13 -58 -52 -233 -85 -390 -72 -334 -75 -385 -24 -466 53 -87 167 -137 257 -113 62 17 107 70 157 189 71 166 260 480 289 480 4 0 19 -26 35 -57 45 -92 124 -221 196 -318 127 -171 245 -268 373 -307 282 -85 711 161 734 421 6 70 -11 136 -43 168 -37 37 -80 26 -168 -40 -39 -29 -86 -64 -104 -77 -50 -34 -148 -62 -191 -54 -86 15 -170 90 -269 242 -65 98 -172 301 -172 325 0 21 173 189 288 280 51 41 154 117 230 170 189 133 235 175 273 252 27 55 31 73 27 120 -3 40 -11 62 -29 81 -44 48 -74 57 -174 52 -82 -3 -100 -8 -176 -44 -216 -105 -491 -345 -782 -684 -110 -127 -143 -159 -145 -143 -7 46 99 509 183 799 26 89 76 225 119 321 75 171 163 424 191 546 19 81 22 216 6 273 -28 104 -139 185 -250 183 -31 -1 -65 -4 -75 -6z"/> 
          <path d="M6150 6109 c-271 -70 -513 -285 -695 -614 -53 -97 -122 -281 -157 -420 -30 -120 -32 -143 -32 -295 -1 -155 1 -170 27 -245 59 -169 148 -259 302 -308 211 -67 443 8 658 212 31 30 59 52 61 50 1 -2 -7 -60 -20 -127 -25 -135 -25 -135 -109 -178 -101 -53 -363 -234 -470 -326 -239 -205 -409 -438 -464 -638 -28 -101 -28 -229 0 -305 33 -90 131 -176 248 -217 79 -28 254 -35 344 -14 161 38 324 159 437 326 148 218 274 551 369 972 17 74 27 100 44 110 43 27 185 87 292 124 61 20 122 46 138 56 91 64 70 222 -37 277 -45 23 -50 24 -114 12 -36 -7 -100 -25 -141 -41 -41 -16 -78 -27 -82 -25 -3 3 0 37 7 77 8 40 34 192 59 338 53 311 71 405 130 680 56 264 62 317 41 362 -17 36 -82 89 -125 103 -49 15 -132 6 -193 -22 l-59 -26 -43 42 c-61 60 -124 81 -244 80 -62 0 -124 -7 -172 -20z m338 -430 c10 -270 -197 -757 -415 -974 -135 -136 -259 -151 -314 -38 -49 101 -32 314 40 498 36 93 129 254 195 337 58 73 152 150 228 189 70 35 190 69 233 66 l30 -2 3 -76z m-318 -1921 c-23 -97 -99 -318 -140 -405 -56 -120 -143 -247 -197 -288 -38 -29 -54 -35 -95 -35 -42 0 -54 5 -80 31 -29 29 -30 33 -26 99 9 122 90 261 240 410 117 116 294 258 306 245 2 -2 -1 -28 -8 -57z"/>
        </g>
      </svg>
    </a>

    <nav aria-label="Global"
         class="-mx-1 mr-auto flex min-w-0 flex-nowrap items-center gap-x-3 overflow-x-auto px-1 [scrollbar-width:none] sm:gap-x-4 md:gap-x-[22px] [&::-webkit-scrollbar]:hidden">
      {% for item in navigation %}
        <a href="{{ item.url }}"
           {% if item.url == page.url %}aria-current="page"{% endif %}
           class="text-[14.5px] whitespace-nowrap transition-colors hover:text-fg
                  {{ 'text-fg' if item.url == page.url else 'text-fg-dim' }}
                  {{ '' if item.compact else 'hidden md:inline' }}">
          {{ i18n.t(item.en, item.de) }}
        </a>
      {% endfor %}
    </nav>

    <button type="button"
            data-open-search
            class="-m-2 shrink-0 p-2 text-fg-dim transition-colors hover:text-fg"
            title="Search (Ctrl+K)"
            data-title-en="Search (Ctrl+K)"
            data-title-de="Suche (Strg+K)">
      <span class="sr-only">{{ i18n.t("Search", "Suche") }}</span>
      <svg class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
    </button>

    <div class="lang-switch shrink-0" role="group" aria-label="Language">
      <button type="button" data-set-lang="en" lang="en">EN</button>
      <button type="button" data-set-lang="de" lang="de">DE</button>
    </div>

    <a href="mailto:{{ site.email }}"
       class="hidden shrink-0 rounded-lg bg-accent px-4 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-accent-hover md:inline-block">
      {{ i18n.t("Get in touch", "Kontakt") }}
    </a>
  </div>
</header>

<script>
  // Language switch. Kept inline and dependency-free so it responds before
  // Alpine has loaded; base.njk applies the stored value on first paint.
  (function () {
    // Text nodes are swapped by CSS, but attributes need JS. Elements opt in
    // with data-ph-en/data-ph-de (placeholder) or data-title-en/data-title-de.
    function applyAttributes(lang) {
      var suffix = lang === 'de' ? 'De' : 'En';
      document.querySelectorAll('[data-ph-en]').forEach(function (el) {
        el.setAttribute('placeholder', el.dataset['ph' + suffix]);
      });
      document.querySelectorAll('[data-title-en]').forEach(function (el) {
        el.setAttribute('title', el.dataset['title' + suffix]);
      });
    }

    // The search modal is an Alpine component listening on the window. The
    // header itself has no x-data, so dispatch the event directly rather than
    // with @click — an Alpine directive outside a component is never bound.
    document.addEventListener('click', function (event) {
      if (event.target.closest('[data-open-search]')) {
        window.dispatchEvent(new CustomEvent('open-search'));
      }
    });

    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-set-lang]');
      if (!button) return;
      var lang = button.dataset.setLang;
      document.documentElement.setAttribute('data-lang', lang);
      try { localStorage.setItem('site-lang', lang); } catch (e) {}
      applyAttributes(lang);
    });

    document.addEventListener('DOMContentLoaded', function () {
      applyAttributes(document.documentElement.getAttribute('data-lang'));
    });
  })();
</script>
