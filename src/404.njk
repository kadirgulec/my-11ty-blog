{% import "partials/i18n.njk" as i18n with context %}

<section class="section border-t-0">
  <div class="shell grid place-items-center py-[clamp(5rem,14vw,10rem)] text-center">
    <div>
      <p class="font-display text-[clamp(4rem,12vw,7rem)] leading-none font-semibold tracking-[-0.03em] text-accent">404</p>
      <h1 class="display mt-4 text-[clamp(1.5rem,4vw,2.25rem)]">
        {{ i18n.t("Page not found", "Seite nicht gefunden") }}
      </h1>
      <p class="mt-4 text-fg-muted">
        {{ i18n.t(
          "Sorry, we couldn’t find the page you’re looking for.",
          "Diese Seite konnten wir leider nicht finden."
        ) }}
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        {# One server-wide 404 page, so each link exists once per language. #}
        <a href="/" class="btn-primary" data-lang-en lang="en">Go back home</a>
        <a href="/de/" class="btn-primary" data-lang-de lang="de">Zur Startseite</a>
        <a href="/blog/" class="btn-ghost" data-lang-en lang="en">Read the blog</a>
        <a href="/de/blog/" class="btn-ghost" data-lang-de lang="de">Zum Blog</a>
      </div>
    </div>
  </div>
</section>
