---
layout: base.njk
# One page per language: /certificates/ and /de/certificates/.
pagination:
  data: locales
  size: 1
  alias: docLang
  addAllPagesToCollections: true
locales: [en, de]
permalink: "{{ '/de' if docLang == 'de' }}/certificates/"
titles:
  en: Certificates
  de: Zertifikate
descriptions:
  en: A collection of my verified credentials, degrees, and continuous learning achievements.
  de: Eine Sammlung meiner geprüften Nachweise, Abschlüsse und laufenden Weiterbildungen.
eleventyComputed:
  title: "{{ titles[docLang] | safe }}"
  description: "{{ descriptions[docLang] | safe }}"
---
{% import "partials/i18n.njk" as i18n with context %}

<section class="section-alt border-t-0">
  <div class="shell pt-14 pb-10 sm:pt-20 sm:pb-12">
    <h1 class="display text-[clamp(2rem,4.4vw,3rem)] tracking-[-0.025em]">
      {{ title }}
    </h1>
    <p class="lede mt-4 text-[17px]">
      {{ description }}
    </p>

    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4">
      <div>
        <dt class="label">{{ i18n.t("Total", "Gesamt") }}</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-accent">{{ certificates.items | length }}</dd>
      </div>
      <div>
        <dt class="label">{{ i18n.t("Issuers", "Aussteller") }}</dt>
        <dd class="mt-1 font-display text-2xl font-semibold text-accent">
          {{ certificates.items | countUnique("issuer") }}
        </dd>
      </div>
    </dl>
  </div>
</section>

<section class="section">
  <div class="section-body">
    <ul class="grid list-none grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] gap-5 p-0">
      {% for cert in certificates.items %}
        <li class="card flex flex-col p-6 transition-colors hover:border-line-4">

          <div class="flex items-center gap-x-4">
            {# Issuer logos are mostly dark artwork, so they sit on a light tile. #}
            <div class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line-2 bg-white p-1.5">
              {% if cert.logo %}
                {% image "src" + cert.logo, cert.issuer, "h-full w-full object-contain", "48px" %}
              {% else %}
                <span class="font-display text-lg font-semibold text-ink" aria-hidden="true">{{ cert.issuer | truncate(1, true, "") }}</span>
              {% endif %}
            </div>
            <div class="min-w-0">
              <div class="truncate text-[13.5px] font-medium text-fg-dim">{{ cert.issuer }}</div>
              <div class="font-mono text-xs text-fg-faint">
                {{ cert.date | monthYear("de-DE" if docLang == "de" else "en-GB") }}
              </div>
            </div>
          </div>

          <h2 class="mt-4 font-display text-base leading-6 font-semibold tracking-[-0.01em] text-fg">
            {{ cert.name }}
          </h2>

          <div class="mt-5 flex flex-1 items-end">
            {% if cert.url and cert.url != '#' %}
              <a href="{{ cert.url }}" target="_blank" rel="noopener" class="btn-small">
                {{ i18n.t("Verify credential", "Nachweis prüfen") }} <span aria-hidden="true">↗</span>
              </a>
            {% else %}
              <span class="badge">{{ i18n.t("On file", "Liegt vor") }}</span>
            {% endif %}
          </div>

        </li>
      {% endfor %}
    </ul>
  </div>
</section>
