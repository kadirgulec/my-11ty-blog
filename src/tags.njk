---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - post
    - posts
    - tagList
  addAllPagesToCollections: true
layout: base.njk
permalink: /tags/{{ tag | slugify }}/
excludeFromSitemap: true
excludeFromSearch: true   # noindex archive pages would only duplicate post hits
robots: "noindex, follow"
eleventyComputed:
  title: "Tag: {{ tag }}"
  description: "Posts tagged {{ tag }} on Kadir Gülec's blog."
---
{% import "partials/i18n.njk" as i18n %}

<section class="section-alt border-t-0">
  <div class="shell pt-14 pb-10 sm:pt-20 sm:pb-12">
    <p class="eyebrow mb-3">{{ i18n.t("Tag", "Schlagwort") }}</p>
    <h1 class="display text-[clamp(2rem,4.4vw,3rem)] tracking-[-0.025em]">
      #{{ tag }}
    </h1>
    <p class="lede mt-4 text-[17px]">
      {{ i18n.t("All posts about " + tag + ".", "Alle Beiträge zu " + tag + ".") }}
    </p>
    <a href="/blog/" class="link-arrow mt-6">
      <span aria-hidden="true">&larr;</span> {{ i18n.t("All posts", "Alle Beiträge") }}
    </a>
  </div>
</section>

<section class="section">
  <div class="section-body">
    <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,300px),1fr))] gap-5">
      {% for post in collections[tag] | reverse %}
        <article class="card flex flex-col gap-2.5 p-6 transition-colors hover:border-line-4"
                 {% if (post.data.docLang or "en") == "de" %}data-lang-de{% else %}data-lang-en{% endif %}>
          <div class="flex flex-wrap items-center gap-x-3 font-mono text-xs text-fg-faint">
            <time datetime="{{ post.date | isoDate }}">
              <span data-lang-en>{{ post.date | postDate("en-GB") }}</span
              ><span data-lang-de>{{ post.date | postDate("de-DE") }}</span>
            </time>
            <span>{{ post.templateContent | readingTime }} min</span>
          </div>
          <h2 class="font-display text-[19px] leading-[1.3] font-semibold">
            <a href="{{ post.url }}" class="text-fg transition-colors hover:text-accent">{{ post.data.title }}</a>
          </h2>
          <p class="m-0 line-clamp-3 text-[15px] text-fg-muted">
            {{ post.data.description or (post.templateContent | striptags | truncate(150)) }}
          </p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
